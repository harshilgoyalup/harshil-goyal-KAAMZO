{
  "entities": {
    "users": {
      "title": "User",
      "description": "Authenticated users (customers and workers)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "worker", "admin"] },
        "verifiedWithPhone": { "type": "boolean" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "phone", "role"]
    },
    "workers": {
      "title": "Worker",
      "description": "Registered workers and KYC verification profiles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "service": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "experience": { "type": "number" },
        "rate": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "city": { "type": "string" },
        "area": { "type": "string" },
        "address": { "type": "string" },
        "about": { "type": "string" },
        "aadhaarNumber": { "type": "string" },
        "kycCode": { "type": "string" },
        "kycVideoUrl": { "type": "string" },
        "kycStatus": { "type": "string", "enum": ["pending_kyc_approval", "approved", "rejected"] },
        "verified": { "type": "boolean" },
        "status": { "type": "string" },
        "rating": { "type": "number" },
        "jobsCompleted": { "type": "number" },
        "availability": { "type": "string" },
        "avatarIcon": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "service", "rate", "city", "aadhaarNumber", "kycCode"]
    },
    "bookings": {
      "title": "Booking",
      "description": "Customer service bookings with workers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "workerService": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "location": { "type": "string" },
        "city": { "type": "string" },
        "jobDescription": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["confirmed", "pending", "completed", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "workerId", "customerName", "customerPhone", "date", "status"]
    }
  },
  "firestore": {
    "defaultRules": "rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /{document=**} { allow read, write: if true; } } }"
  }
}
